      "formula": "CFO (mã 20 LCTT) / Lợi nhuận sau thuế (mã 60 KQKD)",
      "pandas_logic": "float(pd.Series(cf_df[cf_df['1'].astype(str).str.strip() == '20']['3'].values).replace(['-', '–', 'N/A', ''], '0').fillna('0').get(0, 0.0)) / float(pd.Series(income_df[income_df['1'].astype(str).str.strip() == '60']['3'].values).replace(['-', '–', 'N/A', ''], '0').fillna('0').get(0, 1.0))",
