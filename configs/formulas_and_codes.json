  "financial_formula_templates": {
    "ROE (Return on Equity)": {
      "formula": "Lợi nhuận sau thuế (mẹ) / Vốn chủ sở hữu",
      "pandas_logic": "float(pd.Series(income_df[income_df['1'].astype(str).str.strip().isin(['61', '60'])]['3'].values).replace(['-', '–', 'N/A', ''], '0').fillna('0').get(0, 0.0)) / float(pd.Series(balance_df[balance_df['1'].astype(str).str.strip() == '400']['3'].values).replace(['-', '–', 'N/A', ''], '0').fillna('0').get(0, 1.0))",
      "description": "Lấy Mã số 61 hoặc 60 trên Báo cáo KQKD chia cho Mã số 400 trên Bảng Cân đối kế toán."
    },
    "ROA (Return on Assets)": {
      "formula": "Lợi nhuận sau thuế / Tổng tài sản",
      "pandas_logic": "float(pd.Series(income_df[income_df['1'].astype(str).str.strip() == '60']['3'].values).replace(['-', '–', 'N/A', ''], '0').fillna('0').get(0, 0.0)) / float(pd.Series(balance_df[balance_df['1'].astype(str).str.strip() == '270']['3'].values).replace(['-', '–', 'N/A', ''], '0').fillna('0').get(0, 1.0))",
      "description": "Lấy Mã số 60 trên Báo cáo KQKD chia cho Mã số 270 trên Bảng Cân đối kế toán."
    },
    "Biên Lợi nhuận gộp (Gross Profit Margin)": {
      "formula": "Lợi nhuận gộp / Doanh thu thuần",
      "pandas_logic": "float(pd.Series(income_df[income_df['1'].astype(str).str.strip() == '20']['3'].values).replace(['-', '–', 'N/A', ''], '0').fillna('0').get(0, 0.0)) / float(pd.Series(income_df[income_df['1'].astype(str).str.strip() == '10']['3'].values).replace(['-', '–', 'N/A', ''], '0').fillna('0').get(0, 1.0))",
      "description": "Lấy Mã số 20 chia cho Mã số 10 trên Báo cáo KQKD."
    },
    "Biên Lợi nhuận ròng (Net Profit Margin)": {
      "formula": "Lợi nhuận sau thuế / Doanh thu thuần",
      "pandas_logic": "float(pd.Series(income_df[income_df['1'].astype(str).str.strip() == '60']['3'].values).replace(['-', '–', 'N/A', ''], '0').fillna('0').get(0, 0.0)) / float(pd.Series(income_df[income_df['1'].astype(str).str.strip() == '10']['3'].values).replace(['-', '–', 'N/A', ''], '0').fillna('0').get(0, 1.0))",
      "description": "Lấy Mã số 60 chia cho Mã số 10 trên Báo cáo KQKD."
    },
    "Tỉ lệ Nợ / Vốn chủ sở hữu (D/E Ratio)": {
      "formula": "Nợ phải trả / Vốn chủ sở hữu",
      "pandas_logic": "float(pd.Series(balance_df[balance_df['1'].astype(str).str.strip() == '300']['3'].values).replace(['-', '–', 'N/A', ''], '0').fillna('0').get(0, 0.0)) / float(pd.Series(balance_df[balance_df['1'].astype(str).str.strip() == '400']['3'].values).replace(['-', '–', 'N/A', ''], '0').fillna('0').get(0, 1.0))",
      "description": "Lấy Mã số 300 chia cho Mã số 400 trên Bảng Cân đối kế toán."
    },
    "Tỉ lệ Vốn chủ sở hữu / Tổng tài sản": {
      "formula": "Vốn chủ sở hữu / Tổng tài sản",
      "pandas_logic": "float(pd.Series(balance_df[balance_df['1'].astype(str).str.strip() == '400']['3'].values).replace(['-', '–', 'N/A', ''], '0').fillna('0').get(0, 0.0)) / float(pd.Series(balance_df[balance_df['1'].astype(str).str.strip() == '270']['3'].values).replace(['-', '–', 'N/A', ''], '0').fillna('0').get(0, 1.0))",
      "description": "Lấy Mã số 400 chia cho Mã số 270 trên Bảng Cân đối kế toán."
    },
    "Hệ số thanh toán hiện hành (Current Ratio)": {
      "formula": "Tài sản ngắn hạn / Nợ ngắn hạn",
      "pandas_logic": "float(pd.Series(balance_df[balance_df['1'].astype(str).str.strip() == '100']['3'].values).replace(['-', '–', 'N/A', ''], '0').fillna('0').get(0, 0.0)) / float(pd.Series(balance_df[balance_df['1'].astype(str).str.strip() == '310']['3'].values).replace(['-', '–', 'N/A', ''], '0').fillna('0').get(0, 1.0))",
      "description": "Lấy Mã số 100 chia cho Mã số 310 trên Bảng Cân đối kế toán."
    },
    "Hệ số thanh toán nhanh (Quick Ratio)": {
      "formula": "(Tài sản ngắn hạn - Hàng tồn kho) / Nợ ngắn hạn",
      "pandas_logic": "(float(pd.Series(balance_df[balance_df['1'].astype(str).str.strip() == '100']['3'].values).replace(['-', '–', 'N/A', ''], '0').fillna('0').get(0, 0.0)) - float(pd.Series(balance_df[balance_df['1'].astype(str).str.strip() == '140']['3'].values).replace(['-', '–', 'N/A', ''], '0').fillna('0').get(0, 0.0))) / float(pd.Series(balance_df[balance_df['1'].astype(str).str.strip() == '310']['3'].values).replace(['-', '–', 'N/A', ''], '0').fillna('0').get(0, 1.0))",
      "description": "Lấy (Mã số 100 - Mã số 140) tất cả chia cho Mã số 310 trên Bảng Cân đối kế toán."
    },
    "Hệ số khả năng thanh toán lãi vay (Interest Coverage Ratio)": {
      "formula": "EBIT / Chi phí lãi vay = (Lợi nhuận trước thuế + Chi phí lãi vay) / Chi phí lãi vay",
      "pandas_logic": "(float(pd.Series(income_df[income_df['1'].astype(str).str.strip() == '50']['3'].values).replace(['-', '–', 'N/A', ''], '0').fillna('0').get(0, 0.0)) + float(pd.Series(income_df[income_df['1'].astype(str).str.strip() == '23']['3'].values).replace(['-', '–', 'N/A', ''], '0').fillna('0').get(0, 0.0))) / float(pd.Series(income_df[income_df['1'].astype(str).str.strip() == '23']['3'].values).replace(['-', '–', 'N/A', ''], '0').fillna('0').get(0, 1.0))",
      "description": "Lấy (Mã số 50 + Mã số 23) chia cho Mã số 23 trên Báo cáo KQKD."
    },
    "Hệ số dòng tiền hoạt động trên nợ ngắn hạn": {
      "formula": "CFO / Nợ ngắn hạn",
      "pandas_logic": "float(pd.Series(cf_df[cf_df['1'].astype(str).str.strip() == '20']['3'].values).replace(['-', '–', 'N/A', ''], '0').fillna('0').get(0, 0.0)) / float(pd.Series(balance_df[balance_df['1'].astype(str).str.strip() == '310']['3'].values).replace(['-', '–', 'N/A', ''], '0').fillna('0').get(0, 1.0))",
      "description": "Lấy Mã số 20 trên Báo cáo Lưu chuyển tiền tệ chia cho Mã số 310 trên Bảng Cân đối kế toán."
    },
    "Số ngày tồn kho (Days Inventory Outstanding - DIO)": {
      "formula": "(Hàng tồn kho bình quân / Giá vốn hàng bán) * 365",
      "pandas_logic": "(float(pd.Series(balance_df[balance_df['1'].astype(str).str.strip() == '140']['3'].values).replace(['-', '–', 'N/A', ''], '0').fillna('0').get(0, 0.0)) / float(pd.Series(income_df[income_df['1'].astype(str).str.strip() == '11']['3'].values).replace(['-', '–', 'N/A', ''], '0').fillna('0').get(0, 1.0))) * 365",
      "description": "Lấy Hàng tồn kho bình quân (Mã số 140) chia cho Giá vốn hàng bán (Mã số 11) trên Báo cáo KQKD, nhân với 365."
    },
    "Tỷ số dồn tích - Phương pháp Lưu chuyển tiền tệ (Cash Flow Accrual Ratio)": {
      "formula": "(Lợi nhuận sau thuế - (CFO + CFI)) / Tổng tài sản bình quân",
      "pandas_logic": "(float(pd.Series(income_df[income_df['1'].astype(str).str.strip() == '60']['3'].values).replace(['-', '–', 'N/A', ''], '0').fillna('0').get(0, 0.0)) - (float(pd.Series(cf_df[cf_df['1'].astype(str).str.strip() == '20']['3'].values).replace(['-', '–', 'N/A', ''], '0').fillna('0').get(0, 0.0)) + float(pd.Series(cf_df[cf_df['1'].astype(str).str.strip() == '30']['3'].values).replace(['-', '–', 'N/A', ''], '0').fillna('0').get(0, 0.0)))) / float(pd.Series(balance_df[balance_df['1'].astype(str).str.strip() == '270']['3'].values).replace(['-', '–', 'N/A', ''], '0').fillna('0').get(0, 1.0))",
      "description": "Lấy Lợi nhuận sau thuế (Mã số 60) trừ đi tổng của CFO (Mã số 20) và CFI (Mã số 30), sau đó chia cho Tổng tài sản bình quân (Mã số 270)."
    },
    "Tăng trưởng doanh thu thuần": {
      "formula": "(Doanh thu thuần năm nay - Doanh thu thuần năm trước) / Doanh thu thuần năm trước",
      "pandas_logic": "(float(pd.Series(income_df[income_df['1'].astype(str).str.strip() == '10']['3'].values).replace(['-', '–', 'N/A', ''], '0').fillna('0').get(0, 0.0)) - float(pd.Series(income_df[income_df['1'].astype(str).str.strip() == '10']['4'].values).replace(['-', '–', 'N/A', ''], '0').fillna('0').get(0, 0.0))) / float(pd.Series(income_df[income_df['1'].astype(str).str.strip() == '10']['4'].values).replace(['-', '–', 'N/A', ''], '0').fillna('0').get(0, 1.0))",
      "description": "Tính dựa trên giá trị cột năm nay (Mã số 10) và năm trước trên cùng Báo cáo KQKD."
    },
    "CFO Margin (Biên dòng tiền)": {
      "formula": "(Lưu chuyển tiền thuần từ HĐKD / Doanh thu thuần) * 100",
      "pandas_logic": "(float(pd.Series(cf_df[cf_df['1'].astype(str).str.strip() == '20']['3'].values).replace(['-', '–', 'N/A', ''], '0').fillna('0').get(0, 0.0)) / float(pd.Series(income_df[income_df['1'].astype(str).str.strip() == '10']['3'].values).replace(['-', '–', 'N/A', ''], '0').fillna('0').get(0, 1.0))) * 100",
      "description": "Lấy Mã số 20 trên Báo cáo Lưu chuyển tiền tệ chia cho Mã số 10 trên Báo cáo KQKD, nhân với 100."
    },
    "Vốn lưu động thuần (NWC)": {
      "formula": "Tài sản ngắn hạn (mã 100) - Nợ ngắn hạn (mã 310)",
      "pandas_logic": "float(pd.Series(balance_df[balance_df['1'].astype(str).str.strip() == '100']['3'].values).replace(['-', '–', 'N/A', ''], '0').fillna('0').get(0, 0.0)) - float(pd.Series(balance_df[balance_df['1'].astype(str).str.strip() == '310']['3'].values).replace(['-', '–', 'N/A', ''], '0').fillna('0').get(0, 0.0))",
      "description": "Lấy Mã số 100 trừ đi Mã số 310 trên Bảng Cân đối kế toán."
    },
    "Vòng quay Tổng tài sản": {
      "formula": "Doanh thu thuần (mã 10) / Tổng tài sản bình quân (mã 270)",
      "pandas_logic": "float(pd.Series(income_df[income_df['1'].astype(str).str.strip() == '10']['3'].values).replace(['-', '–', 'N/A', ''], '0').fillna('0').get(0, 0.0)) / float(pd.Series(balance_df[balance_df['1'].astype(str).str.strip() == '270']['3'].values).replace(['-', '–', 'N/A', ''], '0').fillna('0').get(0, 1.0))",
      "description": "Lấy Mã số 10 trên Báo cáo KQKD chia cho Tổng tài sản bình quân (Mã số 270) trên Bảng Cân đối kế toán."
