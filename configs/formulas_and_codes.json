    "Tỷ lệ Nợ nần (Debt Ratio)": {
      "formula": "(Tổng nợ phải trả mã 300 / Tổng tài sản mã 270) * 100",
      "pandas_logic": "(float(pd.Series(balance_df[balance_df['1'].astype(str).str.strip() == '300']['3'].values).replace(['-', '–', 'N/A', ''], '0').fillna('0').get(0, 0.0)) / float(pd.Series(balance_df[balance_df['1'].astype(str).str.strip() == '270']['3'].values).replace(['-', '–', 'N/A', ''], '0').fillna('0').get(0, 1.0))) * 100",
      "description": "Lấy Mã số 300 chia cho Mã số 270 trên Bảng Cân đối kế toán, nhân với 100."
